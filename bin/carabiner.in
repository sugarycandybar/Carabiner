#!@PYTHON@

import os
import sys
import signal

# Make sure the package is in the path
# This is mainly for development or when installed in a non-standard prefix
# but python.install_sources usually handles this if installed to site-packages.

def main():
    from carabiner.application import CarabinerApplication
    app = CarabinerApplication()
    return app.run(sys.argv)

if __name__ == "__main__":
    # Allow Ctrl+C to work
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    sys.exit(main())
