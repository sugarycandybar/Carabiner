<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.sugarycandybar.Carabiner</id>
  <name>Carabiner</name>
  <summary>Create and manage secure network tunnels</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.sugarycandybar">
    <name>Sugarycandybar</name>
  </developer>
  <update_contact>candybaralt@gmail.com</update_contact>
  <description>
    <p>
      Carabiner is an easy-to-use utility for sharing HTTP, UDP, or TCP services.
      Share local web servers, game servers, or other network services.
    </p>
    <ul>
      <li>Ngrok, Playit, and Cloudflare tunnels.</li>
      <li>Simple setup wizards for creating new tunnels</li>
      <li>Live monitoring of tunnel status and details</li>
      <li>Background service support for persistent tunnels</li>
    </ul>
  </description>
  <categories>
    <category>Network</category>
  </categories>
  <keywords>
    <keyword>tunnel</keyword>
    <keyword>ngrok</keyword>
    <keyword>playit</keyword>
    <keyword>secure</keyword>
    <keyword>network</keyword>
    <keyword>proxy</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#1c71d8</color>
  </branding>
  <launchable type="desktop-id">io.github.sugarycandybar.Carabiner.desktop</launchable>
  <url type="homepage">https://github.com/sugarycandybar/Carabiner</url>
  <url type="bugtracker">https://github.com/sugarycandybar/Carabiner/issues</url>
  <url type="vcs-browser">https://github.com/sugarycandybar/Carabiner</url>
  <translation type="gettext">carabiner</translation>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/sugarycandybar/Carabiner/screenshots/TunnelsManager.png</image>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/sugarycandybar/Carabiner/screenshots/PlayitTunnelMaker.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.0.0" date="2026-05-31">
      <description>
        <p>Initial release</p>
      </description>
    </release>
  </releases>
</component>
