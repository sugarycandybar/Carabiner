{
	"id": "io.github.sugarycandybar.Carabiner",
	"runtime": "org.gnome.Platform",
	"runtime-version": "50",
	"sdk": "org.gnome.Sdk",
	"command": "carabiner",
	"sdk-extensions": [
		"org.freedesktop.Sdk.Extension.rust-stable"
	],
	"finish-args": [
		"--share=ipc",
		"--socket=fallback-x11",
		"--socket=wayland",
		"--device=dri",
		"--share=network",
		"--talk-name=org.freedesktop.portal.FileChooser",
		"--talk-name=org.freedesktop.Flatpak"
	],
	"cleanup": [
		"/include",
		"/lib/pkgconfig",
		"/man",
		"/share/doc",
		"/share/gtk-doc",
		"/share/man",
		"/share/pkgconfig",
		"*.la",
		"*.a"
	],
	"build-options": {
		"append-path": "/usr/lib/sdk/rust-stable/bin",
		"build-args": [
			"--share=network"
		]
	},
	"modules": [
		{
			"name": "openssh",
			"buildsystem": "simple",
			"build-commands": [
				"mkdir -p /app/bin",
				"if command -v ssh >/dev/null 2>&1; then cp $(command -v ssh) /app/bin/ssh; echo \"copied ssh to /app/bin/ssh\"; else echo \"ssh not found in SDK - will use flatpak-spawn host fallback at runtime\"; fi",
				"if test -f /app/bin/ssh; then chmod +x /app/bin/ssh; fi"
			]
		},
		{
			"name": "carabiner",
			"buildsystem": "meson",
			"builddir": true,
			"config-opts": [
				"--buildtype=debug"
			],
			"sources": [
				{
					"type": "dir",
					"path": "."
				}
			]
		}
	]
}
