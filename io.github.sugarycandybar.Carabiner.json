{
	"id" : "io.github.sugarycandybar.Carabiner",
	"runtime" : "org.gnome.Platform",
	"runtime-version" : "50",
	"sdk" : "org.gnome.Sdk",
	"command" : "carabiner",
	"sdk-extensions" : [
		"org.freedesktop.Sdk.Extension.rust-stable"
	],
	"finish-args" : [
		"--share=network",
		"--share=ipc",
		"--socket=fallback-x11",
		"--device=dri",
		"--socket=wayland"
	],
	"cleanup" : [
		"/include", "/lib/pkgconfig", "/man", "/share/doc",
		"/share/gtk-doc", "/share/man", "/share/pkgconfig",
		"*.la", "*.a"
	],
	"build-options" : {
		"append-path" : "/usr/lib/sdk/rust-stable/bin"
	},
	"modules" : [
		{
			"name" : "carabiner",
			"builddir" : true,
			"buildsystem" : "meson",
			"sources" : [
				{ "type" : "dir", "path" : "." }
			]
		}
	]
}
