#: data/io.github.sugarycandybar.Carabiner.metainfo.xml.in:13
msgid "Carabiner is an easy-to-use utility for HTTP, UDP, or TCP services. Share local web servers, game servers, or other network services."
msgstr "Karabińczyk jest łatwym w użyciu narzędziem do HTTP, UDP lub usług TCP. Udostępniaj lokalne serwery, serwery gier lub inne usługi sieciowe."

#: data/io.github.sugarycandybar.Carabiner.metainfo.xml.in:18
msgid "Ngrok, Playit, and Cloudflare tunnels."
msgstr "Tunele Ngrok, Playit i Cloudflare."

#: data/io.github.sugarycandybar.Carabiner.metainfo.xml.in:19
msgid "Simple setup wizards for creating new tunnels"
msgstr "Proste kreatory konfiguracji do tworzenia nowych tuneli"

#: data/io.github.sugarycandybar.Carabiner.metainfo.xml.in:20
msgid "Live monitoring of tunnel status and details"
msgstr "Monitorowanie stanu i szczegółów tunelu na żywo"

#: data/io.github.sugarycandybar.Carabiner.metainfo.xml.in:21
msgid "Background service support for persistent tunnels"
msgstr "Obsługa serwisu w tle dla trwałych tuneli"

#: data/io.github.sugarycandybar.Carabiner.metainfo.xml.in:36
msgid "Manage network tunnels"
msgstr "Zarządzaj tunelami sieciowymi"

#: data/io.github.sugarycandybar.Carabiner.metainfo.xml.in:40
msgid "Create new network tunnels"
msgstr "Utwórz nowe tunele sieciowe"

#: data/io.github.sugarycandybar.Carabiner.metainfo.xml.in:47
msgid "Minor UI tweaks, improve tunnel reliability"
msgstr "Drobne ulepszenia interfejsu użytkownika, poprawa niezawodności tunelu"

#: data/io.github.sugarycandybar.Carabiner.metainfo.xml.in:52
msgid "Initial release"
msgstr "Pierwsze wydanie"

#: src/portal.rs:21
msgid "Carabiner can keep selected network tunnels running in the background."
